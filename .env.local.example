NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only Supabase service role key. Required for /api/certificates/issue
# (mints signed certificates with bypassed RLS). Never commit this; set in
# Vercel project env as encrypted.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Ed25519 private key (PKCS8 DER, base64). Used by /api/certificates/issue
# to sign payloads. The matching public key is committed in
# src/lib/cert-keys.ts and used everywhere for verification. Generate a new
# one with:
#   node -e "const { generateKeyPairSync } = require('node:crypto'); const
#   { publicKey, privateKey } = generateKeyPairSync('ed25519');
#   console.log('PUBLIC=', publicKey.export({type:'spki',format:'der'})
#     .toString('base64'));
#   console.log('PRIVATE=', privateKey.export({type:'pkcs8',format:'der'})
#     .toString('base64'));"
UDEMI_CERT_PRIVATE_KEY=

# ---------- Automated publishing pipeline (scripts/pipeline/*) ----------
# Used by the udemi-publish-pipeline skill (research → article → script →
# TTS → images → clips → captions → render → publish). See
# docs/superpowers/plans/2026-05-16-udemi-publish-pipeline.md for the full
# wiring. None of these are needed for the Next.js app to boot — only the
# pipeline scripts read them.

# OpenAI — gpt-image-1, Sora 2, Whisper.
OPENAI_API_KEY=

# ElevenLabs — Multilingual v2 TTS. Two voice IDs (one VN, one EN).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_VN=
ELEVENLABS_VOICE_ID_EN=

# Meta Graph API — single integration covers Threads + Instagram + Facebook.
META_ACCESS_TOKEN=
META_THREADS_USER_ID=
META_IG_BUSINESS_ID=
META_FB_PAGE_ID=

# LinkedIn ugcPosts.
LINKEDIN_ACCESS_TOKEN=

# YouTube Data API v3 resumable upload.
YOUTUBE_OAUTH_REFRESH_TOKEN=
